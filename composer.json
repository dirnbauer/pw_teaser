{
	"name": "t3/pw_teaser",
	"type": "typo3-cms-extension",
	"description": "Create powerful, dynamic page teasers with data from page properties and its content elements. Based on Extbase and Fluid Template Engine.",
	"homepage": "https://github.com/dirnbauer/pw_teaser",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"typo3",
		"typo3-extension",
		"teaser",
		"extbase",
		"fluid"
	],
	"support": {
		"issues": "https://github.com/dirnbauer/pw_teaser/issues",
		"source": "https://github.com/dirnbauer/pw_teaser",
		"docs": "https://docs.typo3.org/p/t3/pw_teaser/main/en-us/"
	},
	"require": {
		"php": "^8.3",
		"typo3/cms-core": "^13.4 || ^14.3",
		"typo3/cms-install": "^13.4 || ^14.3"
	},
	"autoload": {
		"psr-4": {
			"PwTeaserTeam\\PwTeaser\\": "Classes"
		}
	},
	"extra": {
		"typo3/cms": {
			"extension-key": "pw_teaser"
		}
	},
	"suggest": {
		"georgringer/numbered-pagination": "Provides numbered pagination with ellipsis (optional, not default)"
	},
	"require-dev": {
		"a9f/typo3-fractor": "^0.5.9",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^11.5 || ^12.0",
		"saschaegerer/phpstan-typo3": "^3.0",
		"ssch/typo3-rector": "^3.12",
		"typo3/testing-framework": "^9.0"
	},
	"config": {
		"allow-plugins": {
			"a9f/fractor-extension-installer": true,
			"typo3/cms-composer-installers": true,
			"typo3/class-alias-loader": true
		},
		"sort-packages": true
	}
}
